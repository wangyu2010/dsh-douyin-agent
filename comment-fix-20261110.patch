+++ b/tests/human-input.test.mjs
@@ -0,0 +1,45 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRandom, typingDelay, humanePath, normalizeDraft } from '../human-input.mjs';
+
+test('类人输入：打字节奏有抖动、标点后停顿更久，不是固定10毫秒', () => {
+  const random = createRandom('typing-seed'), source = '这段剪辑的节奏很好，配色也舒服。', delays = [];
+  for (const character of source) delays.push(typingDelay(character, random));
+  assert.equal(delays.length, Array.from(source).length);
+  assert.ok(Math.min(...delays) >= 25); assert.ok(Math.max(...delays) <= 1200);
+  // 不应退化成一个常数节奏
+  assert.ok(new Set(delays).size > 8, '打字间隔必须离散');
+  assert.ok(Math.max(...delays) - Math.min(...delays) >= 40);
+  // 标点后的停顿应长于普通汉字
+  const random2 = createRandom('punctuation-seed');
+  const letters = Array.from({ length: 40 }, () => typingDelay('好', random2));
+  const marks = Array.from({ length: 40 }, () => typingDelay('。', random2));
+  const mean = values => values.reduce((sum, value) => sum + value, 0) / values.length;
+  assert.ok(mean(marks) > mean(letters));
+});
+
+test('类人输入：鼠标轨迹是连续多段带加速度的曲线，而不是一次瞬移', () => {
+  const path = humanePath({ x: 10, y: 10 }, { x: 400, y: 260 }, createRandom('path-seed'));
+  assert.ok(path.length >= 9, '必须有足够中间点');
+  assert.deepEqual({ x: path.at(-1).x, y: path.at(-1).y }, { x: 400, y: 260 });
+  assert.ok(path.every(step => Number.isFinite(step.x) && Number.isFinite(step.y) && step.delay > 0));
+  // 相邻点间距受限，不会出现跨越整屏的瞬移
+  for (let index = 1; index < path.length; index++) assert.ok(Math.hypot(path[index].x - path[index - 1].x, path[index].y - path[index - 1].y) <= 140);
+  // 轨迹不应是一条直线：中途存在偏离直线连接的采样点
+  const deviation = path.slice(1, -1).some(step => Math.abs((step.x - 10) * 250 - (step.y - 10) * 390) > 200);
+  assert.equal(deviation, true);
+  // 起止点重合时只返回一个落点，不产生空轨迹
+  assert.deepEqual(humanePath({ x: 5, y: 5 }, { x: 5, y: 5 }, createRandom()).length, 1);
+});
+
+test('类人输入：草稿回读只归一化不可见字符与空白，不改写正文', () => {
+  assert.equal(normalizeDraft('\u200b光影 很舒服。'), '光影 很舒服。');
+  assert.equal(normalizeDraft('  a\n b  '), 'a b');
+  assert.equal(normalizeDraft('这个账号的节奏好'), '这个账号的节奏好');
+});
+
+test('类人输入：同一随机种子可复现，不同种子产生不同节奏', () => {
+  const build = seed => { const random = createRandom(seed); return Array.from({ length: 12 }, () => typingDelay('好', random)); };
+  assert.deepEqual(build('seed-a'), build('seed-a'));
+  assert.notDeepEqual(build('seed-a'), build('seed-b'));
+});
